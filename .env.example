HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified

# Database: SQLite is used when DATABASE_CLIENT is unset. Fine locally; set postgres or
# mysql (plus DATABASE_HOST, DATABASE_PORT, DATABASE_NAME, DATABASE_USERNAME,
# DATABASE_PASSWORD) in every deployed environment.
DATABASE_CLIENT=
# Comma-separated sites allowed to call the API from a browser, e.g. https://example.com.
# Leave unset locally (any origin); always set it in production.
CORS_ORIGIN=
# Strapi's built-in MCP server (/mcp). Set to false to turn it off in an environment.
MCP_ENABLED=true

# content-publisher: platform keys (read from here only, never from the admin panel)
DEVTO_API_KEY=
MEDIUM_USER_ID=
MEDIUM_API_TOKEN=
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=
# LinkedIn and Facebook apps used by the Connect buttons
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# content-publisher chat (floating button in the plugin)
ANTHROPIC_API_KEY=
# optional: the chat's default model (editors can switch in the chat). Unset = claude-haiku-4-5
ANTHROPIC_MODEL=
# an admin token (Settings > Administration Panel > Admin Tokens) for Strapi's /mcp server
STRAPI_MCP_TOKEN=
