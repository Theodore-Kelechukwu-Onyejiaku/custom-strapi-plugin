{
  "name": "content-publisher",
  "version": "2.0.0",
  "description": "Publish Strapi entries to Dev.to, Medium, Bluesky, LinkedIn and Facebook from the admin, and track where each one went.",
  "license": "MIT",
  "author": "Theodore Kelechukwu Onyejiaku <theodoreonyejiaku@gmail.com>",
  "homepage": "https://github.com/Theodore-Kelechukwu-Onyejiaku/custom-strapi-plugin#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Theodore-Kelechukwu-Onyejiaku/custom-strapi-plugin.git",
    "directory": "src/plugins/content-publisher"
  },
  "bugs": {
    "url": "https://github.com/Theodore-Kelechukwu-Onyejiaku/custom-strapi-plugin/issues"
  },
  "keywords": [
    "strapi",
    "plugin",
    "strapi-plugin",
    "publishing",
    "cross-posting",
    "syndication",
    "dev.to",
    "medium",
    "bluesky",
    "atproto",
    "linkedin",
    "facebook",
    "mcp"
  ],
  "type": "commonjs",
  "exports": {
    "./package.json": "./package.json",
    "./strapi-admin": {
      "types": "./dist/admin/src/index.d.ts",
      "source": "./admin/src/index.tsx",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./strapi-server": {
      "types": "./dist/server/src/index.d.ts",
      "source": "./server/src/index.ts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    }
  },
  "files": [
    "dist",
    "logo.svg",
    "logo-mono.svg",
    "logo.png"
  ],
  "scripts": {
    "build": "strapi-plugin build",
    "watch": "strapi-plugin watch",
    "watch:link": "strapi-plugin watch:link",
    "verify": "strapi-plugin verify",
    "test:ts:front": "run -T tsc -p admin/tsconfig.json",
    "test:ts:back": "run -T tsc -p server/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.85",
    "@ai-sdk/mcp": "^2.0.81",
    "@ai-sdk/react": "^4.0.152",
    "@strapi/design-system": "^2.2.4",
    "@strapi/icons": "^2.2.4",
    "ai": "^7.0.148",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-intl": "^7.1.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.28.1",
    "remark-gfm": "^4.0.1",
    "styled-components": "^6.1.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@strapi/sdk-plugin": "^5.2.8",
    "@strapi/strapi": "5.60.0",
    "@strapi/typescript-utils": "5.60.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "prettier": "^3.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "styled-components": "^6.1.14",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  },
  "peerDependencies": {
    "@strapi/strapi": "^5.54.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "styled-components": "^6.1.14"
  },
  "strapi": {
    "kind": "plugin",
    "name": "content-publisher",
    "displayName": "Content Publisher",
    "description": "Publish Strapi entries to Dev.to, Medium, Bluesky, LinkedIn and Facebook from the admin, and track where each one went."
  }
}
